<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #f4f6f9;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ClassExamDetailController">
   <content>
      <VBox fx:id="rootPane" minWidth="0.0" spacing="20.0" style="-fx-background-color: #f4f6f9;">
         <padding>
            <Insets bottom="24.0" left="20.0" right="20.0" top="18.0" />
         </padding>
         <children>

            <!-- TOP HEADER: Back Button, Class Title & Lecturer Badge -->
            <VBox minWidth="0.0" spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="10.0">
                     <children>
                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleBack" style="-fx-font-size: 13px; -fx-padding: 8px 16px;" styleClass="secondary-button" text="← Back to Exams" />
                     </children>
                  </HBox>

                  <HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="12.0">
                     <children>
                        <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label fx:id="classTitleLabel" styleClass="page-title" text="CEIT-3101 — Exam &amp; Grading Details" wrapText="true" />
                              <Label fx:id="classSubtitleLabel" styleClass="page-subtitle" text="Computer Engineering &amp; IT | Third Year | First Semester" wrapText="true" />
                           </children>
                        </VBox>
                        <Label fx:id="lecturerBadgeLabel" minWidth="-Infinity" style="-fx-background-color: #eff6ff; -fx-text-fill: #1d4ed8; -fx-font-size: 11.5px; -fx-font-weight: bold; -fx-padding: 6px 14px; -fx-background-radius: 12px; -fx-border-color: #bfdbfe; -fx-border-radius: 12px;" text="👨‍🏫 Lecturer: Sadayo Kawakami" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- ROW 1 (TOP): GRADING CRITERIA & WEIGHTAGE DISTRIBUTION -->
            <GridPane hgap="16.0" minWidth="0.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="0.0" percentWidth="50.0" />
                  <ColumnConstraints minWidth="0.0" percentWidth="50.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
               <children>

                  <!-- Left Card: Grading Criteria -->
                  <VBox minWidth="0.0" spacing="12.0" styleClass="panel-card" GridPane.columnIndex="0">
                     <children>
                        <HBox alignment="CENTER_LEFT" minWidth="0.0">
                           <children>
                              <Label styleClass="panel-header" text="🎓 Grading Criteria" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button fx:id="editWeightageBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleEditWeightage" style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 6px; -fx-border-color: #e2e8f0; -fx-border-radius: 6px; -fx-padding: 4px 10px; -fx-cursor: hand;" text="✎ Edit" />
                           </children>
                        </HBox>

                        <VBox minWidth="0.0" spacing="0.0" style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-radius: 8px; -fx-background-radius: 8px;">
                           <children>
                              <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 8px 14px; -fx-background-radius: 8px 8px 0 0; -fx-border-color: transparent transparent #f1f5f9 transparent; -fx-border-width: 0 0 1 0;">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #334155;" text="Criteria" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #334155;" text="Weightage" />
                                 </children>
                              </HBox>

                              <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 8px 14px; -fx-border-color: transparent transparent #f1f5f9 transparent; -fx-border-width: 0 0 1 0;">
                                 <children>
                                    <Circle fill="#3b82f6" radius="4.5" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="Tutorial" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="tutorialWeightLabel" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;" text="15%" />
                                 </children>
                              </HBox>

                              <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 8px 14px; -fx-border-color: transparent transparent #f1f5f9 transparent; -fx-border-width: 0 0 1 0;">
                                 <children>
                                    <Circle fill="#9333ea" radius="4.5" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="Assignment" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="assignmentWeightLabel" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;" text="15%" />
                                 </children>
                              </HBox>

                              <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 8px 14px; -fx-border-color: transparent transparent #f1f5f9 transparent; -fx-border-width: 0 0 1 0;">
                                 <children>
                                    <Circle fill="#fbbf24" radius="4.5" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="Lab Test" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="labTestWeightLabel" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;" text="10%" />
                                 </children>
                              </HBox>

                              <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 8px 14px; -fx-border-color: transparent transparent #f1f5f9 transparent; -fx-border-width: 0 0 1 0;">
                                 <children>
                                    <Circle fill="#06b6d4" radius="4.5" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="Practical" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="practicalWeightLabel" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;" text="0%" />
                                 </children>
                              </HBox>

                              <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-padding: 8px 14px; -fx-border-color: transparent transparent #f1f5f9 transparent; -fx-border-width: 0 0 1 0;">
                                 <children>
                                    <Circle fill="#22c55e" radius="4.5" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="Final Exam" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="finalWeightLabel" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;" text="60%" />
                                 </children>
                              </HBox>

                              <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 8px 14px; -fx-background-radius: 0 0 8px 8px;">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;" text="Total" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="totalWeightLabel" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;" text="100%" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- Right Card: Weightage Distribution Donut Chart (Responsive) -->
                  <VBox minWidth="0.0" spacing="12.0" styleClass="panel-card" GridPane.columnIndex="1">
                     <children>
                        <Label styleClass="panel-header" text="📊 Weightage Distribution" />

                        <HBox alignment="CENTER" minWidth="0.0" spacing="12.0" VBox.vgrow="ALWAYS">
                           <children>
                              <StackPane maxHeight="165.0" maxWidth="165.0" minHeight="145.0" minWidth="145.0" prefHeight="165.0" prefWidth="165.0">
                                 <children>
                                    <PieChart fx:id="weightagePieChart" labelsVisible="false" legendVisible="false" minHeight="145.0" minWidth="145.0" prefHeight="165.0" prefWidth="165.0" startAngle="0.0" />
                                    <StackPane maxHeight="64.0" maxWidth="64.0" minHeight="64.0" minWidth="64.0" style="-fx-background-color: white; -fx-background-radius: 50em;">
                                       <children>
                                          <VBox alignment="CENTER" spacing="1.0">
                                             <children>
                                                <Label style="-fx-font-size: 10px; -fx-text-fill: #64748b;" text="Total" />
                                                <Label fx:id="donutTotalLabel" style="-fx-font-size: 12.5px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" text="100%" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </StackPane>
                                 </children>
                              </StackPane>

                              <VBox alignment="CENTER_LEFT" maxWidth="165.0" minWidth="95.0" prefWidth="140.0" spacing="9.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                       <children>
                                          <Circle fill="#3b82f6" radius="4.0" />
                                          <Label style="-fx-font-size: 11.5px; -fx-text-fill: #475569;" text="Tutorial" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="legendTutLabel" minWidth="-Infinity" style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #0f172a;" text="15%" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                       <children>
                                          <Circle fill="#9333ea" radius="4.0" />
                                          <Label style="-fx-font-size: 11.5px; -fx-text-fill: #475569;" text="Assignment" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="legendAssignLabel" minWidth="-Infinity" style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #0f172a;" text="15%" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                       <children>
                                          <Circle fill="#fbbf24" radius="4.0" />
                                          <Label style="-fx-font-size: 11.5px; -fx-text-fill: #475569;" text="Lab Test" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="legendLabLabel" minWidth="-Infinity" style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #0f172a;" text="10%" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                       <children>
                                          <Circle fill="#06b6d4" radius="4.0" />
                                          <Label style="-fx-font-size: 11.5px; -fx-text-fill: #475569;" text="Practical" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="legendPracticalLabel" minWidth="-Infinity" style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #0f172a;" text="0%" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                       <children>
                                          <Circle fill="#22c55e" radius="4.0" />
                                          <Label style="-fx-font-size: 11.5px; -fx-text-fill: #475569;" text="Final Exam" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <Label fx:id="legendFinalLabel" minWidth="-Infinity" style="-fx-font-weight: bold; -fx-font-size: 11.5px; -fx-text-fill: #0f172a;" text="60%" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

               </children>
            </GridPane>

            <!-- ADMIN ACTION CARD: Schedule Exam for This Class (Hidden for Lecturers) -->
            <HBox fx:id="scheduleExamCard" alignment="CENTER_LEFT" minWidth="0.0" spacing="14.0" style="-fx-padding: 16px 20px;" styleClass="panel-card">
               <children>
                  <StackPane maxHeight="42.0" maxWidth="42.0" minHeight="42.0" minWidth="42.0" style="-fx-background-color: #eff6ff; -fx-background-radius: 10px; -fx-border-color: #bfdbfe; -fx-border-radius: 10px;">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #2563eb;" text="📝" />
                     </children>
                  </StackPane>
                  <VBox minWidth="0.0" spacing="2.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 14px;" styleClass="panel-header" text="Schedule &amp; Assign Class Exam" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Create a new Tutorial, Quiz, or Final Exam for this class and publish it directly to its exam calendar." wrapText="true" />
                     </children>
                  </VBox>
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleScheduleExamForClass" styleClass="action-button" text="+ Schedule Exam" />
               </children>
            </HBox>

            <!-- ROW 2: FILTER & SEARCH CLASS EXAMS -->
            <VBox minWidth="0.0" spacing="12.0" styleClass="panel-card">
               <children>
                  <Label styleClass="panel-header" text="Filter &amp; Search Class Exams" />
                  <HBox alignment="BOTTOM_LEFT" minWidth="0.0" spacing="10.0">
                     <children>
                        <VBox minWidth="110.0" prefWidth="165.0" spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Assessment Type" />
                              <ComboBox fx:id="typeFilterCombo" maxWidth="Infinity" minWidth="0.0" prefWidth="0.0" promptText="All Types" styleClass="shaded-combo" />
                           </children>
                        </VBox>
                        <VBox minWidth="105.0" prefWidth="150.0" spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Status" />
                              <ComboBox fx:id="statusFilterCombo" maxWidth="Infinity" minWidth="0.0" prefWidth="0.0" promptText="All Status" styleClass="shaded-combo" />
                           </children>
                        </VBox>
                        <VBox minWidth="0.0" spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Search Exams" />
                              <HBox minWidth="0.0" spacing="8.0">
                                 <children>
                                    <TextField fx:id="searchField" minWidth="60.0" prefWidth="0.0" promptText="Search tutorial, quiz, final, or date..." style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 8px 12px;" HBox.hgrow="ALWAYS" />
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleFilter" style="-fx-padding: 8px 14px;" styleClass="action-button" text="Filter" />
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleResetFilters" styleClass="filter-reset-btn" text="↺ Reset" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- ROW 3: CLASS EXAMS LIST & STYLED EXAM CALENDAR -->
            <GridPane hgap="16.0" minWidth="0.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="0.0" percentWidth="66.0" />
                  <ColumnConstraints minWidth="0.0" percentWidth="34.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
               <children>

                  <!-- Left: Class Exams Table & Action Footer -->
                  <VBox minWidth="0.0" spacing="14.0" styleClass="panel-card" GridPane.columnIndex="0">
                     <children>
                        <Label fx:id="examsListHeaderLabel" styleClass="panel-header" text="📅 Class Exams List" />

                        <TableView fx:id="examsTable" minWidth="0.0" prefHeight="315.0" prefWidth="0.0" style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="titleColumn" prefWidth="100.0" reorderable="false" sortable="false" text="Title" />
                              <TableColumn fx:id="subjectColumn" prefWidth="150.0" reorderable="false" sortable="false" text="Subject" />
                              <TableColumn fx:id="dateColumn" prefWidth="90.0" reorderable="false" sortable="false" text="Exam Date" />
                              <TableColumn fx:id="durationColumn" prefWidth="70.0" reorderable="false" sortable="false" text="Duration" />
                              <TableColumn fx:id="statusColumn" prefWidth="90.0" reorderable="false" sortable="false" text="Status" />
                           </columns>
                        </TableView>

                        <HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="8.0">
                           <children>
                              <Button fx:id="viewResultBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleViewResult" styleClass="action-button" text="📊 View &amp; Audit Results" />
                              <Region HBox.hgrow="ALWAYS" />
                              <HBox fx:id="adminActionBox" alignment="CENTER_RIGHT" spacing="6.0">
                                 <children>
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleEditExam" styleClass="secondary-button" text="✎ Edit" />
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleTogglePublishStatus" styleClass="btn-success" text="✔ Toggle Status" />
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleDeleteExam" styleClass="btn-danger-solid" text="🗑 Delete" />
                                 </children>
                              </HBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Right: Exam Calendar (Matches Create Class DatePicker Theme) -->
                  <VBox minWidth="0.0" spacing="12.0" styleClass="panel-card" GridPane.columnIndex="1">
                     <children>
                        <Label styleClass="panel-header" text="📅 Exam Calendar" />

                        <VBox minWidth="0.0" spacing="0.0" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-background-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(15,23,42,0.06), 8, 0, 0, 2);">
                           <children>
                              <!-- Navy Header Bar (#1b315e) -->
                              <HBox alignment="CENTER" minWidth="0.0" spacing="6.0" style="-fx-background-color: #1b315e; -fx-background-radius: 7px 7px 0 0; -fx-padding: 9px 10px;">
                                 <children>
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handlePrevMonth" style="-fx-background-color: rgba(255,255,255,0.14); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 6px; -fx-padding: 4px 8px; -fx-cursor: hand;" text="◀" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="monthYearLabel" style="-fx-font-weight: bold; -fx-font-size: 12.5px; -fx-text-fill: white;" text="November 2026" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleNextMonth" style="-fx-background-color: rgba(255,255,255,0.14); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 6px; -fx-padding: 4px 8px; -fx-cursor: hand;" text="▶" />
                                 </children>
                              </HBox>

                              <!-- Calendar Grid -->
                              <GridPane fx:id="calendarGrid" alignment="CENTER" hgap="2.0" minWidth="0.0" style="-fx-padding: 6px;" vgap="3.0">
                                 <columnConstraints>
                                    <ColumnConstraints halignment="CENTER" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints halignment="CENTER" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints halignment="CENTER" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints halignment="CENTER" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints halignment="CENTER" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints halignment="CENTER" minWidth="0.0" percentWidth="14.28" />
                                    <ColumnConstraints halignment="CENTER" minWidth="0.0" percentWidth="14.28" />
                                 </columnConstraints>
                                 <rowConstraints>
                                    <RowConstraints minHeight="24.0" />
                                    <RowConstraints minHeight="30.0" />
                                    <RowConstraints minHeight="30.0" />
                                    <RowConstraints minHeight="30.0" />
                                    <RowConstraints minHeight="30.0" />
                                    <RowConstraints minHeight="30.0" />
                                    <RowConstraints minHeight="30.0" />
                                 </rowConstraints>
                                 <children>
                                    <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 9.5px; -fx-font-weight: bold; -fx-text-fill: #475569; -fx-background-color: #f8fafc; -fx-padding: 4px 0; -fx-background-radius: 4px;" text="SUN" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                    <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 9.5px; -fx-font-weight: bold; -fx-text-fill: #475569; -fx-background-color: #f8fafc; -fx-padding: 4px 0; -fx-background-radius: 4px;" text="MON" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                    <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 9.5px; -fx-font-weight: bold; -fx-text-fill: #475569; -fx-background-color: #f8fafc; -fx-padding: 4px 0; -fx-background-radius: 4px;" text="TUE" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                    <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 9.5px; -fx-font-weight: bold; -fx-text-fill: #475569; -fx-background-color: #f8fafc; -fx-padding: 4px 0; -fx-background-radius: 4px;" text="WED" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                    <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 9.5px; -fx-font-weight: bold; -fx-text-fill: #475569; -fx-background-color: #f8fafc; -fx-padding: 4px 0; -fx-background-radius: 4px;" text="THU" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                                    <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 9.5px; -fx-font-weight: bold; -fx-text-fill: #475569; -fx-background-color: #f8fafc; -fx-padding: 4px 0; -fx-background-radius: 4px;" text="FRI" GridPane.columnIndex="5" GridPane.rowIndex="0" />
                                    <Label alignment="CENTER" maxWidth="Infinity" style="-fx-font-size: 9.5px; -fx-font-weight: bold; -fx-text-fill: #475569; -fx-background-color: #f8fafc; -fx-padding: 4px 0; -fx-background-radius: 4px;" text="SAT" GridPane.columnIndex="6" GridPane.rowIndex="0" />
                                 </children>
                              </GridPane>

                              <!-- Compact Legend Bar -->
