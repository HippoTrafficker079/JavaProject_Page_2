<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f4f6f9;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.AdminExamsController">
   <content>
      <VBox fx:id="rootPane" spacing="20.0" style="-fx-background-color: #f4f6f9;">
         <padding>
            <Insets bottom="24.0" left="20.0" right="20.0" top="18.0" />
         </padding>
         <children>

            <!-- TOP BAR: Notification & Admin Profile -->
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label style="-fx-font-size: 16px;" text="🔔" />
                  <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #ffffff; -fx-background-radius: 20px; -fx-padding: 6px 14px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 6, 0, 0, 2); -fx-border-color: #e2e8f0; -fx-border-radius: 20px;">
                     <children>
                        <StackPane style="-fx-background-color: #f3e8ff; -fx-background-radius: 12px; -fx-min-width: 24px; -fx-min-height: 24px;">
                           <children>
                              <Label style="-fx-font-size: 13px; -fx-text-fill: #9333ea;" text="⚙" />
                           </children>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="1.0">
                           <children>
                              <Label style="-fx-font-size: 9px; -fx-text-fill: #16a34a; -fx-font-weight: bold;" text="● LOGGED IN AS" />
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 12px;" text="System Administrator" />
                           </children>
                        </VBox>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 10px;" text="▼" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- PAGE TITLE, SUBTITLE & DEPARTMENT BADGE -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label styleClass="page-title" text="Exams Oversight (Admin)" />
                        <Label styleClass="page-subtitle" text="Select a class to manage its tutorials, quizzes, finals, exam calendar, and grading weightage." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="examsDeptLabel" style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 5px 12px; -fx-background-radius: 12px; -fx-border-color: #bfdbfe; -fx-border-radius: 12px;" text="CEIT (Computer Engineering and Information Technology)" />
               </children>
            </HBox>

            <!-- 1. METRIC CARDS ROW -->
            <HBox spacing="12.0">
               <children>
                  <!-- 1. Drafts -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 14px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #f3e8ff; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #9333ea; -fx-font-size: 18px;" text="📄" />
                                 </children>
                              </StackPane>
                              <Label fx:id="draftsCountLabel" styleClass="metric-value" text="0" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="Unpublished Drafts" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Awaiting admin approval" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- 2. Finished -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 14px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #dcfce7; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #16a34a; -fx-font-size: 18px;" text="✓" />
                                 </children>
                              </StackPane>
                              <Label fx:id="finishedCountLabel" styleClass="metric-value" text="0" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="Finished" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Department-wide" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- 3. Total Exams -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 14px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #ffedd5; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #ea580c; -fx-font-size: 18px;" text="📚" />
                                 </children>
                              </StackPane>
                              <Label fx:id="totalExamsCountLabel" styleClass="metric-value" text="0" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="Total Dept Exams" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Across all lecturers" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- SECTION HEADER: CLASS LIST -->
            <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: transparent transparent #cbd5e1 transparent; -fx-border-width: 0 0 2 0; -fx-padding: 6px 0 8px 2px;">
               <children>
                  <Label style="-fx-text-fill: #0f172a; -fx-font-size: 15px; -fx-font-weight: 800;" text="📚  Class List (Select a Class to View Exams &amp; Grading)" />
                  <Label fx:id="classListBadge" style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 12px; -fx-padding: 2px 8px;" text="0 available" />
               </children>
            </HBox>

            <!-- FILTER & SEARCH CLASSES -->
            <VBox spacing="12.0" style="-fx-padding: 16px;" styleClass="panel-card">
               <children>
                  <Label style="-fx-font-size: 14px;" styleClass="panel-header" text="Filter &amp; Search Classes" />
                  <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                     <children>
                        <VBox minWidth="140.0" prefWidth="175.0" spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Academic Year" />
                              <ComboBox fx:id="academicYearCombo" maxWidth="Infinity" promptText="All Years" styleClass="shaded-combo" />
                           </children>
                        </VBox>

                        <VBox minWidth="140.0" prefWidth="175.0" spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Semester" />
                              <ComboBox fx:id="semesterCombo" maxWidth="Infinity" promptText="All Semesters" styleClass="shaded-combo" />
                           </children>
                        </VBox>

                        <VBox minWidth="140.0" spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Search Classes" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <TextField fx:id="searchField" minWidth="100.0" promptText="🔍 Search by class code, title, major, lecturer..." style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 7px 12px;" HBox.hgrow="ALWAYS" />
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleResetFilters" styleClass="filter-reset-btn" text="↻ Reset" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- CLASS CARDS GRID (2 rows x 3 columns = 6 per page) -->
            <GridPane fx:id="cardsGrid" hgap="16.0" vgap="16.0">
               <columnConstraints>
                  <ColumnConstraints percentWidth="33.33" />
                  <ColumnConstraints percentWidth="33.33" />
                  <ColumnConstraints percentWidth="33.33" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="240.0" prefHeight="240.0" />
                  <RowConstraints minHeight="240.0" prefHeight="240.0" />
               </rowConstraints>
            </GridPane>

            <!-- PAGINATION FOOTER -->
			<HBox alignment="CENTER_LEFT">
			   <children>
			      <Label fx:id="paginationInfoLabel" style="-fx-text-fill: #475569; -fx-font-size: 13.5px;" text="Showing 1 - 6 of 12 classes" />
			      <Region HBox.hgrow="ALWAYS" />
			      <HBox fx:id="paginationControlsBox" alignment="CENTER" spacing="6.0" />
			   </children>
			</HBox>

         </children>
      </VBox>
   </content>
</ScrollPane>