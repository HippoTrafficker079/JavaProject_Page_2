<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1024.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.AdminMainController">
   <left>
      <VBox alignment="TOP_CENTER" prefWidth="240.0" style="-fx-padding: 0;" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <!-- TOP: BRANDING & LOGO AREA -->
            <VBox alignment="CENTER" spacing="6.0">
               <padding>
                  <Insets bottom="18.0" left="20.0" right="20.0" top="25.0" />
               </padding>
               <children>
                  <ImageView fx:id="logoImageView" fitHeight="110.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@YTU_logo.png" />
                     </image>
                  </ImageView>
                  <VBox alignment="CENTER" spacing="1.0" style="-fx-padding: 4px 0 0 0;">
                     <children>
                        <Label styleClass="sidebar-title" text="STUDENT INFORMATION" textAlignment="CENTER" textFill="#80c2f8" wrapText="true">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <Label styleClass="sidebar-title" text="MANAGEMENT" textAlignment="CENTER" textFill="#80c2f8" wrapText="true">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                     </children>
                  </VBox>
                  <Label style="-fx-text-fill: #dc2626; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 4px 0 0 0;" text="● ADMIN OVERSIGHT" />
               </children>
            </VBox>

            <!-- FULL-WIDTH NAVIGATION BUTTONS + LEFT ACCENT INDICATOR -->
            <StackPane alignment="TOP_LEFT" prefWidth="240.0">
               <children>
                  <VBox spacing="8.0">
                     <children>
                        <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#switchTab" prefHeight="45.0" prefWidth="240.0" styleClass="nav-button" text="  📊  Dashboard" />
                        <Button fx:id="btnClasses" maxWidth="Infinity" onAction="#switchTab" prefHeight="45.0" prefWidth="240.0" styleClass="nav-button" text="  📚  Classes" />
                        <Button fx:id="btnExams" maxWidth="Infinity" onAction="#switchTab" prefHeight="45.0" prefWidth="240.0" styleClass="nav-button" text="  📝  Exams Oversight" />
                        <Button fx:id="btnStudents" maxWidth="Infinity" onAction="#switchTab" prefHeight="45.0" prefWidth="240.0" styleClass="nav-button" text="  👥  Students" />
                        <Button fx:id="btnAttendance" maxWidth="Infinity" onAction="#switchTab" prefHeight="45.0" prefWidth="240.0" styleClass="nav-button" text="  📅  Attendance" />
                     </children>
                  </VBox>

                  <!-- Left Edge Active Indicator Bar -->
                  <Region fx:id="sidebarIndicator" maxHeight="33.0" maxWidth="4.0" minHeight="33.0" minWidth="4.0" mouseTransparent="true" prefHeight="33.0" prefWidth="4.0" style="-fx-background-color: #2563eb; -fx-background-radius: 0 4 4 0;" />
               </children>
            </StackPane>

            <!-- Flexible Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Bottom YTU Building Graphic -->
            <ImageView fx:id="buildingImageView" fitWidth="240.0" mouseTransparent="true" pickOnBounds="true" preserveRatio="true" smooth="true">
               <image>
                  <Image url="@YTU_building_2.png" />
               </image>
            </ImageView>
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentArea" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>