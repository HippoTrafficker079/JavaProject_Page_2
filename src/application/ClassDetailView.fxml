<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ClassDetailController">
   <content>
      <VBox fx:id="rootPane" spacing="20.0" styleClass="content-area">
         <children>
            
            <!-- TOP SECTION: Back Button Above Title, Left-Aligned -->
            <VBox alignment="TOP_LEFT" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleBackToClasses" style="-fx-font-size: 13px; -fx-padding: 8px 16px;" styleClass="secondary-button" text="← Back to Classes" />
                  <VBox spacing="3.0">
                     <children>
                        <Label fx:id="classNameLabel" styleClass="page-title" text="Students (IT201)" />
                        <Label styleClass="page-subtitle" text="Manage students, attendance, and grades for this class." />
                     </children>
                  </VBox>
               </children>
            </VBox>
            
            <!-- METRIC CARDS ROW -->
            <HBox spacing="12.0">
               <children>
                  <!-- 1. Total Students -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 14px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #dbeafe; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #2563eb; -fx-font-size: 18px;" text="👥" />
                                 </children>
                              </StackPane>
                              <Label fx:id="totalStudentsLabel" styleClass="metric-value" text="56" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="Total Students" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Enrolled in class" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- 2. Active Students -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 14px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #dcfce7; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #16a34a; -fx-font-size: 18px;" text="🎓" />
                                 </children>
                              </StackPane>
                              <Label fx:id="activeStudentsLabel" styleClass="metric-value" text="52" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="Active Students" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Good standing" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- 3. At Risk Students -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 14px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #fef3c7; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #d97706; -fx-font-size: 18px;" text="❗" />
                                 </children>
                              </StackPane>
                              <Label fx:id="atRiskLabel" styleClass="metric-value" text="3" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="At Risk Students" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Attendance &lt; 75%" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- 4. Inactive Students -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 14px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #ffe4e6; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #e11d48; -fx-font-size: 18px;" text="🚫" />
                                 </children>
                              </StackPane>
                              <Label fx:id="inactiveLabel" styleClass="metric-value" text="1" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="Inactive Students" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Attendance ≤ 50%" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
            
            <!-- SEPARATE FILTER BOX ABOVE TABLE (Responsive in Mid-Size Windows) -->
            <VBox spacing="10.0" styleClass="panel-card">
               <children>
                  <Label styleClass="panel-header" text="Filter Students" />
                  <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                     <children>
                        <VBox minWidth="130.0" prefWidth="175.0" spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Roll No" />
                              <ComboBox fx:id="rollNoFilterCombo" maxWidth="Infinity" promptText="All Roll Nos" styleClass="shaded-combo" />
                           </children>
                        </VBox>
                        <VBox minWidth="130.0" prefWidth="175.0" spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Status" />
                              <ComboBox fx:id="statusFilterCombo" maxWidth="Infinity" promptText="All Status" styleClass="shaded-combo" />
                           </children>
                        </VBox>
                        <VBox minWidth="120.0" spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Search" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <TextField fx:id="searchField" minWidth="80.0" promptText="Search name, email, ID..." style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 7px 12px;" HBox.hgrow="ALWAYS" />
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleFilter" style="-fx-padding: 7px 16px;" styleClass="action-button" text="Filter" />
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleReset" styleClass="filter-reset-btn" text="↺ Reset" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- STUDENT LIST PANEL CARD (Constrained Columns Fit Mid-Size Window) -->
            <VBox spacing="15.0" styleClass="panel-card">
               <children>
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label styleClass="panel-header" text="Student List" />
                     </children>
                  </HBox>

                  <TableView fx:id="studentTable" prefHeight="265.0" style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;">
                    <columnResizePolicy>
                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="80.0" text="ID" reorderable="false" sortable="false" />
                      <TableColumn fx:id="colRollNo" prefWidth="120.0" text="Roll No" reorderable="false" sortable="false" />
                      <TableColumn fx:id="colName" prefWidth="175.0" text="Student Name" reorderable="false" sortable="false" />
                      <TableColumn fx:id="colEmail" prefWidth="205.0" text="Email" reorderable="false" sortable="false" />
                      <TableColumn fx:id="colAttendance" prefWidth="95.0" text="Attendance" reorderable="false" sortable="false" />
                      <TableColumn fx:id="colGpa" prefWidth="75.0" text="GPA" reorderable="false" sortable="false" />
                      <TableColumn fx:id="colStatus" prefWidth="110.0" text="Status" reorderable="false" sortable="false" />
                    </columns>
                  </TableView>
                  
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <HBox spacing="10.0">
                           <children>
                              <Button fx:id="removeStudentBtn" mnemonicParsing="false" onAction="#handleRemoveStudent" styleClass="footer-btn, danger-button" text="🗑 Remove" />
                           </children>
                        </HBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="footerCountLabel" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Showing 1 - 8 of 56 students" />
                     </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </content>
</ScrollPane>