<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.ResultController">
   <content>
      <VBox fx:id="rootPane" spacing="20.0" style="-fx-padding: 20px;">
         <children>
            
            <!-- TOP BAR: Back Button Above Title, Left-Aligned -->
            <VBox alignment="TOP_LEFT" spacing="12.0">
               <children>
                  <Button fx:id="backBtn" mnemonicParsing="false" onAction="#handleBack" style="-fx-font-size: 13px; -fx-padding: 8px 16px;" styleClass="secondary-button" text="← Back to Exams" />
                  <VBox spacing="3.0">
                     <children>
                        <Label fx:id="examTitleLabel" styleClass="page-title" text="Result: Tutorial 1 - Data Structures" />
                        <Label fx:id="examSubtitleLabel" styleClass="page-subtitle" text="Class: 2A | Date: 10 Jan 2024 | Total Marks: 50" />
                     </children>
                  </VBox>
               </children>
            </VBox>
            
            <!-- METRIC CARDS ROW -->
        <HBox spacing="12.0">
           <children>
              <!-- 1. Average Score -->
              <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 14px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                 <children>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                       <children>
                          <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #e0f2fe; -fx-background-radius: 50em;">
                             <children>
                                <Label style="-fx-text-fill: #0284c7; -fx-font-size: 18px;" text="📊" />
                             </children>
                          </StackPane>
                          <Label fx:id="avgScoreLabel" styleClass="metric-value" text="78.4" />
                       </children>
                    </HBox>
                    <VBox spacing="1.0">
                       <children>
                          <Label styleClass="metric-title" text="Average Score" />
                          <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Class mean" />
                       </children>
                    </VBox>
                 </children>
              </VBox>

              <!-- 2. Pass Results -->
              <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 14px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                 <children>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                       <children>
                          <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #dcfce7; -fx-background-radius: 50em;">
                             <children>
                                <Label style="-fx-text-fill: #16a34a; -fx-font-size: 18px;" text="✅" />
                             </children>
                          </StackPane>
                          <Label fx:id="passRateLabel" styleClass="metric-value" text="92%" />
                       </children>
                    </HBox>
                    <VBox spacing="1.0">
                       <children>
                          <Label styleClass="metric-title" text="Pass Results" />
                          <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Passing rate" />
                       </children>
                    </VBox>
                 </children>
              </VBox>

              <!-- 3. Total Students -->
              <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 14px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                 <children>
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                       <children>
                          <StackPane maxHeight="38.0" maxWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #fef3c7; -fx-background-radius: 50em;">
                             <children>
                                <Label style="-fx-text-fill: #d97706; -fx-font-size: 18px;" text="⏱" />
                             </children>
                          </StackPane>
                          <Label fx:id="totalGradedLabel" styleClass="metric-value" text="12" />
                       </children>
                    </HBox>
                    <VBox spacing="1.0">
                       <children>
                          <Label styleClass="metric-title" text="Total Students" />
                          <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Graded" />
                       </children>
                    </VBox>
                 </children>
              </VBox>
           </children>
        </HBox>

            <!-- GRADING CRITERIA & PIE CHART SECTION -->
            <GridPane hgap="15.0">
               <columnConstraints>
                  <ColumnConstraints percentWidth="55.0" />
                  <ColumnConstraints percentWidth="45.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
               </rowConstraints>
               <children>
                  
                  <!-- Left: Grading Criteria Box -->
                  <VBox spacing="10.0" styleClass="panel-card" GridPane.columnIndex="0">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label styleClass="panel-header" text="🎓 Grading Criteria" />
                              <HBox HBox.hgrow="ALWAYS" />
                              <Button mnemonicParsing="false" styleClass="reset-button" text="✏️ Edit" />
                           </children>
                        </HBox>
                        
                        <!-- Criteria Table Simulation (Least to Most) -->
                        <VBox style="-fx-border-color: #e2e8f0; -fx-border-radius: 6px; -fx-background-radius: 6px;">
                           <children>
                              <HBox style="-fx-background-color: #f8fafc; -fx-padding: 8px 12px; -fx-border-color: transparent transparent #e2e8f0 transparent;">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="Criteria" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #475569;" text="Weightage" />
                                 </children>
                              </HBox>
                              <!-- 1. Quiz (5%) -->
                              <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 8px 12px; -fx-border-color: transparent transparent #f1f5f9 transparent;">
                                 <children>
                                    <StackPane maxHeight="10.0" maxWidth="10.0" minHeight="10.0" minWidth="10.0" style="-fx-background-color: #fbbf24; -fx-background-radius: 5px;" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #1e293b;" text="Quiz" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #1e293b; -fx-font-weight: bold;" text="5%" />
                                 </children>
                              </HBox>
                              <!-- 2. Assignment (15%) -->
                              <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 8px 12px; -fx-border-color: transparent transparent #f1f5f9 transparent;">
                                 <children>
                                    <StackPane maxHeight="10.0" maxWidth="10.0" minHeight="10.0" minWidth="10.0" style="-fx-background-color: #9333ea; -fx-background-radius: 5px;" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #1e293b;" text="Assignment" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #1e293b; -fx-font-weight: bold;" text="15%" />
                                 </children>
                              </HBox>
                              <!-- 3. Tutorial (20%) -->
                              <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 8px 12px; -fx-border-color: transparent transparent #f1f5f9 transparent;">
                                 <children>
                                    <StackPane maxHeight="10.0" maxWidth="10.0" minHeight="10.0" minWidth="10.0" style="-fx-background-color: #3b82f6; -fx-background-radius: 5px;" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #1e293b;" text="Tutorial" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #1e293b; -fx-font-weight: bold;" text="20%" />
                                 </children>
                              </HBox>
                              <!-- 4. Final (60%) -->
                              <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-padding: 8px 12px; -fx-border-color: transparent transparent #f1f5f9 transparent;">
                                 <children>
                                    <StackPane maxHeight="10.0" maxWidth="10.0" minHeight="10.0" minWidth="10.0" style="-fx-background-color: #22c55e; -fx-background-radius: 5px;" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #1e293b;" text="Final" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-size: 12px; -fx-text-fill: #1e293b; -fx-font-weight: bold;" text="60%" />
                                 </children>
                              </HBox>
                              <!-- Total -->
                              <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 8px 12px;">
                                 <children>
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;" text="Total" />
                                    <HBox HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #0f172a;" text="100%" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- Right: Vertically Centered Doughnut Chart Box -->
                  <VBox spacing="10.0" styleClass="panel-card" GridPane.columnIndex="1">
                     <children>
                        <Label styleClass="panel-header" text="📊 Weightage Distribution" />
                        <HBox alignment="CENTER" spacing="20.0">
                           <children>
                              <!-- Doughnut Chart with Center Total Hole -->
                              <StackPane>
                                 <children>
                                    <PieChart fx:id="weightagePieChart" labelsVisible="false" legendVisible="false" prefHeight="190.0" prefWidth="190.0" />
                                    <StackPane maxHeight="65.0" maxWidth="65.0" style="-fx-background-color: white; -fx-background-radius: 32px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 6, 0, 0, 2);">
                                       <children>
                                          <VBox alignment="CENTER" spacing="0.0">
                                             <children>
                                                <Label style="-fx-font-size: 10px; -fx-text-fill: #64748b; -fx-font-weight: bold;" text="Total" />
                                                <Label style="-fx-font-size: 13px; -fx-text-fill: #0f172a; -fx-font-weight: bold;" text="100%" />
                                             </children>
                                          </VBox>
                                       </children>
                                    </StackPane>
                                 </children>
                              </StackPane>

                              <!-- Custom Legend List -->
                              <VBox alignment="CENTER_LEFT" spacing="12.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <StackPane maxHeight="10.0" maxWidth="10.0" minHeight="10.0" minWidth="10.0" style="-fx-background-color: #fbbf24; -fx-background-radius: 5px;" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="Quiz" />
                                          <HBox HBox.hgrow="ALWAYS" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #0f172a; -fx-font-weight: bold;" text="5%" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <StackPane maxHeight="10.0" maxWidth="10.0" minHeight="10.0" minWidth="10.0" style="-fx-background-color: #9333ea; -fx-background-radius: 5px;" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="Assignment" />
                                          <HBox HBox.hgrow="ALWAYS" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #0f172a; -fx-font-weight: bold;" text="15%" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <StackPane maxHeight="10.0" maxWidth="10.0" minHeight="10.0" minWidth="10.0" style="-fx-background-color: #3b82f6; -fx-background-radius: 5px;" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="Tutorial" />
                                          <HBox HBox.hgrow="ALWAYS" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #0f172a; -fx-font-weight: bold;" text="20%" />
                                       </children>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <StackPane maxHeight="10.0" maxWidth="10.0" minHeight="10.0" minWidth="10.0" style="-fx-background-color: #22c55e; -fx-background-radius: 5px;" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #334155;" text="Final" />
                                          <HBox HBox.hgrow="ALWAYS" />
                                          <Label style="-fx-font-size: 12px; -fx-text-fill: #0f172a; -fx-font-weight: bold;" text="60%" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

               </children>
            </GridPane>

            <!-- STUDENT RESULTS TABLE -->
        <VBox spacing="12.0" styleClass="panel-card">
           <children>
              <HBox alignment="CENTER_LEFT">
                 <children>
                    <Label styleClass="panel-header" text="👥 Student Results" />
                 </children>
              </HBox>
              
              <!-- Max Marks Info Message in a Striking Colored Rectangle Box -->
              <HBox alignment="CENTER_LEFT" style="-fx-background-color: #fef3c7; -fx-border-color: #f59e0b; -fx-background-radius: 6px; -fx-border-radius: 6px; -fx-padding: 10px 14px;">
                 <children>
                    <Label fx:id="maxMarksInfoLabel" style="-fx-font-size: 12px; -fx-text-fill: #b45309; -fx-font-weight: bold;" text="ℹ️ Maximum Marks Info: Final Exam = 100 | Tutorial = 50 | Quiz = 20" />
                 </children>
              </HBox>

              <!-- FILTERS & SEARCH ROW ABOVE TABLE -->
              <HBox alignment="CENTER_LEFT" spacing="15.0">
                 <children>
                    <VBox prefWidth="220.0" spacing="4.0">
                       <children>
                          <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Roll No" />
                          <ComboBox fx:id="rollNoFilterCombo" maxWidth="Infinity" promptText="All Roll Nos" styleClass="shaded-combo" />
                       </children>
                    </VBox>
                    <VBox prefWidth="200.0" spacing="4.0">
                       <children>
                          <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Status" />
                          <ComboBox fx:id="statusFilterCombo" maxWidth="Infinity" promptText="All" styleClass="shaded-combo" />
                       </children>
                    </VBox>
                    <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Search" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <TextField fx:id="searchField" promptText="Search Students..." style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 7px 12px;" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="resetFilterBtn" mnemonicParsing="false" onAction="#handleResetFilters" styleClass="secondary-button" text="↻ Reset" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                 </children>
              </HBox>

              <TableView fx:id="resultsTable" prefHeight="250.0" style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;">
                 <columns>
                    <TableColumn fx:id="colRollNo" prefWidth="140.0" text="Roll No" reorderable="false" resizable="false" sortable="false" />
                    
                    <!-- Unlocked 'resizable' so this column automatically stretches to eat all the blank space! -->
                    <TableColumn fx:id="colName" prefWidth="290.0" text="Student Name" reorderable="false" resizable="true" sortable="false" />
                    
                    <TableColumn fx:id="colMarks" prefWidth="180.0" text="Total Marks" reorderable="false" resizable="false" sortable="false" />
                    <TableColumn fx:id="colStatus" prefWidth="160.0" text="Status" reorderable="false" resizable="false" sortable="false" />
                 </columns>
              </TableView>
           </children>
        </VBox>

     </children>
  </VBox>
   </content>
</ScrollPane>
