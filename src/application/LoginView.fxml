<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.LoginController">
   <children>
      <!-- LEFT BRANDING PANEL -->
      <VBox alignment="CENTER" prefWidth="380.0" spacing="20.0" style="-fx-background-color: #1b315e; -fx-padding: 40px;">
         <children>
            <ImageView fx:id="logoImageView" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label style="-fx-text-fill: #ffffff; -fx-font-size: 22px; -fx-font-weight: bold;" text="YTU" />
                  <Label style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: bold;" text="YANGON TECHNOLOGICAL UNIVERSITY" textAlignment="CENTER" wrapText="true" />
               </children>
            </VBox>
            <Region VBox.vgrow="ALWAYS" />
            <Label style="-fx-text-fill: #64748b; -fx-font-size: 11px;" text="Student Information Management System" />
         </children>
      </VBox>

      <!-- RIGHT LOGIN FORM PANEL -->
      <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
         </padding>
         <children>
            <VBox maxWidth="400.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-padding: 30px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 16, 0, 0, 4);">
               <children>
                  <!-- CENTERED HEADERS -->
                  <VBox alignment="CENTER" spacing="4.0">
                     <children>
                        <Label styleClass="page-title" style="-fx-font-size: 20px;" text="Sign Into An Account" textAlignment="CENTER" />
                        <Label styleClass="page-subtitle" text="Select your role and enter credentials." textAlignment="CENTER" />
                     </children>
                  </VBox>

                  <!-- Pill-Shaped Toggle Role Switcher -->
                  <HBox alignment="CENTER" style="-fx-background-color: #e2e8f0; -fx-background-radius: 22px; -fx-padding: 3px;">
                     <children>
                        <Button fx:id="roleTeacherBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSelectTeacher" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 18px; -fx-padding: 8px; -fx-cursor: hand; -fx-font-size: 12px;" text="LECTURER" HBox.hgrow="ALWAYS" />
                        <Button fx:id="roleAdminBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSelectAdmin" style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 18px; -fx-padding: 8px; -fx-cursor: hand; -fx-font-size: 12px;" text="ADMIN" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <!-- Credentials Form with Symbols -->
                  <VBox spacing="12.0">
                     <children>
                        <!-- Username Field with User Icon -->
                        <VBox spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Username or Employee ID" />
                              <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 0 10px;">
                                 <children>
                                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-padding: 0 8px 0 0;" text="👤" />
                                    <TextField fx:id="usernameField" promptText="Enter username..." HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 8px 0;" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <!-- Password Field with Lock Icon & Functional Eye Toggle -->
                        <VBox spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Password" />
                              <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 0 10px;">
                                 <children>
                                    <Label style="-fx-text-fill: #64748b; -fx-font-size: 13px; -fx-padding: 0 8px 0 0;" text="🔒" />
                                    <StackPane HBox.hgrow="ALWAYS">
                                       <children>
                                          <PasswordField fx:id="passwordField" promptText="Enter password..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 8px 0;" />
                                          <TextField fx:id="visiblePasswordField" promptText="Enter password..." visible="false" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 8px 0;" />
                                       </children>
                                    </StackPane>
                                    <Label fx:id="eyeIconLabel" onMouseClicked="#togglePasswordVisibility" style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-cursor: hand; -fx-padding: 0 0 0 8px;" text="👁" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <Button fx:id="loginBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" styleClass="action-button" text="Sign In" style="-fx-padding: 10px; -fx-font-size: 13px;" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>