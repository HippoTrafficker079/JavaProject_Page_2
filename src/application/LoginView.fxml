<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="700.0" prefWidth="1024.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.LoginController">
   <children>
      <!-- LEFT BRANDING PANEL (Matches Minimal YTU Navy Layout) -->
      <VBox alignment="CENTER" prefWidth="420.0" style="-fx-background-color: #1b315e; -fx-padding: 36px 40px;">
         <children>
            <ImageView fitHeight="148.0" fitWidth="334.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@YTU_logo.png" />
               </image>
            </ImageView>
            <VBox alignment="CENTER" spacing="8.0" />
            <Region VBox.vgrow="ALWAYS" />
            <Region VBox.vgrow="ALWAYS" />
            <Label style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Student Information Management System" textAlignment="CENTER" wrapText="true" />
         </children>
      </VBox>

      <!-- RIGHT LOGIN FORM PANEL -->
      <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
         <padding>
            <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
         </padding>
         <children>
            <VBox maxWidth="410.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-background-radius: 16px; -fx-padding: 32px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 16, 0, 0, 4);">
               <children>
                  <!-- CENTERED HEADERS -->
                  <VBox alignment="CENTER" spacing="4.0">
                     <children>
                        <Label style="-fx-font-size: 20px;" styleClass="page-title" text="Sign Into An Account" textAlignment="CENTER" />
                        <Label styleClass="page-subtitle" text="Select your role and enter credentials." textAlignment="CENTER" />
                     </children>
                  </VBox>

                  <!-- Pill-Shaped Toggle Role Switcher -->
                  <HBox alignment="CENTER" style="-fx-background-color: #e2e8f0; -fx-background-radius: 22px; -fx-padding: 3px;">
                     <children>
                        <Button fx:id="roleTeacherBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSelectTeacher" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 18px; -fx-padding: 8px; -fx-cursor: hand; -fx-font-size: 12px;" text="LECTURER" HBox.hgrow="ALWAYS" />
                        <Button fx:id="roleAdminBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleSelectAdmin" style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-weight: bold; -fx-background-radius: 18px; -fx-padding: 8px; -fx-cursor: hand; -fx-font-size: 12px;" text="ADMIN" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <!-- Four Clean Rounded Input Bars: Username, Email, Password, Confirm Password -->
                  <VBox spacing="13.0">
                     <children>
                        <!-- 1. Username Input Bar -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-padding: 4px 14px;">
                           <children>
                              <Label style="-fx-text-fill: #64748b; -fx-font-size: 15px;" text="👤" />
                              <TextField fx:id="usernameField" promptText="Username" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10px 0;" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <!-- 2. Email Input Bar -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-padding: 4px 14px;">
                           <children>
                              <Label style="-fx-text-fill: #64748b; -fx-font-size: 15px;" text="✉" />
                              <TextField fx:id="emailField" promptText="Email" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10px 0;" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <!-- 3. Password Input Bar with Working Eye Toggle -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-padding: 4px 14px;">
                           <children>
                              <Label style="-fx-text-fill: #64748b; -fx-font-size: 15px;" text="🔒" />
                              <StackPane HBox.hgrow="ALWAYS">
                                 <children>
                                    <PasswordField fx:id="passwordField" promptText="Password" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10px 0;" />
                                    <TextField fx:id="visiblePasswordField" promptText="Password" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10px 0;" visible="false" />
                                 </children>
                              </StackPane>
                              <Label fx:id="eyeIconLabel" alignment="CENTER" maxWidth="24.0" minWidth="24.0" onMouseClicked="#togglePasswordVisibility" prefWidth="24.0" style="-fx-text-fill: #64748b; -fx-font-size: 15px; -fx-cursor: hand;" text="👁" />
                           </children>
                        </HBox>

                        <!-- 4. Confirm Password Input Bar with Working Eye Toggle -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8px; -fx-border-color: #cbd5e1; -fx-border-radius: 8px; -fx-padding: 4px 14px;">
                           <children>
                              <Label style="-fx-text-fill: #64748b; -fx-font-size: 15px;" text="🔒" />
                              <StackPane HBox.hgrow="ALWAYS">
                                 <children>
                                    <PasswordField fx:id="confirmPasswordField" promptText="Confirm Password" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10px 0;" />
                                    <TextField fx:id="visibleConfirmPasswordField" promptText="Confirm Password" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px; -fx-text-fill: #1e293b; -fx-prompt-text-fill: #94a3b8; -fx-padding: 10px 0;" visible="false" />
                                 </children>
                              </StackPane>
                              <Label fx:id="confirmEyeIconLabel" alignment="CENTER" maxWidth="24.0" minWidth="24.0" onMouseClicked="#toggleConfirmPasswordVisibility" prefWidth="24.0" style="-fx-text-fill: #64748b; -fx-font-size: 15px; -fx-cursor: hand;" text="👁" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <Button fx:id="loginBtn" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" style="-fx-padding: 12px; -fx-font-size: 14px;" styleClass="action-button" text="Sign In" />
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</HBox>
