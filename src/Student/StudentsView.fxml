<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Student.StudentsController">
   <content>
      <VBox fx:id="rootPane" minWidth="0.0" spacing="20.0" style="-fx-background-color: #f4f6f9;">
         <padding>
            <Insets bottom="24.0" left="20.0" right="20.0" top="18.0" />
         </padding>
         <children>

            <!-- TOP BAR: Notification & Profile Badge -->
            <HBox alignment="CENTER_RIGHT" minWidth="0.0" spacing="15.0">
               <children>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label style="-fx-font-size: 16px;" text="🔔" />
                  <HBox alignment="CENTER" minWidth="-Infinity" spacing="8.0" style="-fx-background-color: #ffffff; -fx-background-radius: 20px; -fx-padding: 6px 14px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 6, 0, 0, 2); -fx-border-color: #e2e8f0; -fx-border-radius: 20px;">
                     <children>
                        <StackPane fx:id="profileIconBg" style="-fx-background-color: #f3e8ff; -fx-background-radius: 12px; -fx-min-width: 24px; -fx-min-height: 24px;">
                           <children>
                              <Label fx:id="profileIconLabel" style="-fx-font-size: 13px; -fx-text-fill: #9333ea;" text="⚙" />
                           </children>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="1.0">
                           <children>
                              <Label style="-fx-font-size: 9px; -fx-text-fill: #16a34a; -fx-font-weight: bold;" text="● LOGGED IN AS" />
                              <Label fx:id="profileNameLabel" style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 12px;" text="System Administrator" />
                           </children>
                        </VBox>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 10px;" text="▼" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- PAGE TITLE, SUBTITLE & DEPARTMENT BADGE -->
            <HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="12.0">
               <children>
                  <VBox minWidth="0.0" spacing="3.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="pageTitleLabel" styleClass="page-title" text="Department Students" />
                        <Label fx:id="pageSubtitleLabel" styleClass="page-subtitle" text="Inspect students, view full academic profiles, and jump straight to attendance records." wrapText="true" />
                     </children>
                  </VBox>
                  <Label fx:id="deptBadgeLabel" minWidth="-Infinity" style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 5px 12px; -fx-background-radius: 12px; -fx-border-color: #bfdbfe; -fx-border-radius: 12px;" text="CEIT (Computer Engineering and Information Technology)" />
               </children>
            </HBox>

            <!-- FILTER & SEARCH CARD -->
            <VBox minWidth="0.0" spacing="12.0" style="-fx-padding: 16px;" styleClass="panel-card">
               <children>
                  <Label style="-fx-font-size: 14px;" styleClass="panel-header" text="Filter &amp; Search Students" />
                  <HBox alignment="BOTTOM_LEFT" minWidth="0.0" spacing="10.0">
                     <children>
                        <VBox minWidth="120.0" prefWidth="175.0" spacing="4.0">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Academic Year" />
                              <ComboBox fx:id="yearFilterCombo" maxWidth="Infinity" minWidth="0.0" prefWidth="0.0" promptText="All Years" styleClass="shaded-combo" />
                           </children>
                        </VBox>

                        <VBox minWidth="130.0" prefWidth="185.0" spacing="4.0">
                           <children>
                              <Label fx:id="secondaryFilterLabel" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Department / Major" />
                              <ComboBox fx:id="secondaryFilterCombo" maxWidth="Infinity" minWidth="0.0" prefWidth="0.0" promptText="All Majors" styleClass="shaded-combo" />
                           </children>
                        </VBox>

                        <VBox minWidth="0.0" spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Search Students" />
                              <HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="8.0">
                                 <children>
                                    <TextField fx:id="searchField" minWidth="80.0" prefWidth="0.0" promptText="🔍 Search roll no, name, or phone..." style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 7px 12px;" HBox.hgrow="ALWAYS" />
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleSearch" style="-fx-padding: 7px 16px;" styleClass="action-button" text="Filter" />
                                    <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleReset" styleClass="filter-reset-btn" text="↺ Reset" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- HINT BANNER -->
            <HBox alignment="CENTER_LEFT" minWidth="0.0" style="-fx-background-color: #eff6ff; -fx-padding: 10px 14px; -fx-background-radius: 6px; -fx-border-color: #bfdbfe; -fx-border-radius: 6px;">
               <children>
                  <Label style="-fx-text-fill: #1d4ed8; -fx-font-weight: bold; -fx-font-size: 12.5px;" text="💡  Double-click any student row to inspect their full profile, or select a row and click &quot;View Attendance&quot;." wrapText="true" />
               </children>
            </HBox>

            <!-- STUDENT DIRECTORY TABLE CARD -->
            <VBox minWidth="0.0" spacing="14.0" styleClass="panel-card">
               <children>
                  <HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="10.0">
                     <children>
                        <Label styleClass="panel-header" text="👥 Student Directory" />
                        <Label fx:id="studentCountBadge" style="-fx-background-color: #dbeafe; -fx-text-fill: #1d4ed8; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 12px; -fx-padding: 2px 9px;" text="0 students" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleRefresh" styleClass="filter-reset-btn" text="↻ Refresh" />
                     </children>
                  </HBox>

                  <TableView fx:id="studentTable" minWidth="0.0" prefHeight="400.0" prefWidth="0.0" style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;">
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                     <columns>
                        <TableColumn fx:id="colNo" prefWidth="50.0" reorderable="false" sortable="false" text="No" />
                        <TableColumn fx:id="colRollNo" prefWidth="125.0" reorderable="false" sortable="false" text="Roll No" />
                        <TableColumn fx:id="colName" prefWidth="195.0" reorderable="false" sortable="false" text="Student Name" />
                        <TableColumn fx:id="colMajor" prefWidth="95.0" reorderable="false" sortable="false" text="Major" />
                        <TableColumn fx:id="colYear" prefWidth="120.0" reorderable="false" sortable="false" text="Year" />
                        <TableColumn fx:id="colPhone" prefWidth="145.0" reorderable="false" sortable="false" text="Phone No" />
                     </columns>
                  </TableView>

                  <HBox alignment="CENTER_LEFT" minWidth="0.0" spacing="10.0">
                     <children>
                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleViewAttendance" styleClass="action-button" text="📅 View Attendance" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="footerCountLabel" style="-fx-text-fill: #475569; -fx-font-size: 13.5px;" text="Showing 0 students" />
                     </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </content>
</ScrollPane>