<BorderPane prefHeight="768.0" prefWidth="1280.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.AdminMainController">
   <left>
      <VBox prefWidth="240.0" spacing="15.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <!-- BRANDING & LOGO AREA -->
            <VBox alignment="CENTER" spacing="8.0" style="-fx-padding: 10px 0 20px 0;">
               <children>
                  <Region prefHeight="0.0" prefWidth="240.0" />
                  <ImageView fx:id="logoImageView" fitHeight="78.0" fitWidth="154.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../../../Downloads/photo_2026-10-14_21-55-21-removebg-preview.png" />
                     </image></ImageView>
                  <Label styleClass="sidebar-title" text="STUDENT INFORMATION&#10;MANAGEMENT" textAlignment="CENTER" />
                  <Label alignment="CENTER" prefHeight="19.0" prefWidth="149.0" style="-fx-text-fill: #dc2626; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 2px 0 0 0;" text="● ADMIN OVERSIGHT" />
               </children>
            </VBox>
            <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#switchTab" styleClass="nav-button" text="  📊  Dashboard" />
            <Button fx:id="btnClasses" maxWidth="Infinity" onAction="#switchTab" styleClass="nav-button" text="  📚  Classes" />
            <Button fx:id="btnExams" maxWidth="Infinity" onAction="#switchTab" styleClass="nav-button" text="  📝  Exams Oversight" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentArea" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
