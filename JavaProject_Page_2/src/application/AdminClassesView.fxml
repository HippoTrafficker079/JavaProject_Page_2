<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.AdminClassesController">
   <content>
      <VBox fx:id="rootPane" spacing="18.0" style="-fx-padding: 22px;">
         <children>

            <!-- TOP BAR: Notification & Admin Profile Badge -->
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label style="-fx-font-size: 16px;" text="🔔" />
                  <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #ffffff; -fx-background-radius: 20px; -fx-padding: 6px 14px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 6, 0, 0, 2); -fx-border-color: #e2e8f0; -fx-border-radius: 20px;">
                     <children>
                        <StackPane style="-fx-background-color: #f3e8ff; -fx-background-radius: 12px; -fx-min-width: 24px; -fx-min-height: 24px;">
                           <children>
                              <Label style="-fx-font-size: 13px; -fx-text-fill: #9333ea;" text="⚙" />
                           </children>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="1.0">
                           <children>
                              <Label style="-fx-font-size: 9px; -fx-text-fill: #16a34a; -fx-font-weight: bold;" text="● LOGGED IN AS" />
                              <Label style="-fx-font-weight: bold; -fx-text-fill: #1e293b; -fx-font-size: 12px;" text="System Administrator" />
                           </children>
                        </VBox>
                        <Label style="-fx-text-fill: #64748b; -fx-font-size: 10px;" text="▼" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- PAGE TITLE, SUBTITLE & DEPARTMENT BADGE -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <VBox spacing="3.0">
                     <children>
                        <Label fx:id="classHeaderLabel" styleClass="page-title" text="Admin Class Management" />
                        <Label styleClass="page-subtitle" text="Register courses, assign lecturers, update schedules, and manage class enrollment rosters." />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Label fx:id="adminClassesDeptLabel" style="-fx-background-color: #eff6ff; -fx-text-fill: #2563eb; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 5px 12px; -fx-background-radius: 12px; -fx-border-color: #bfdbfe; -fx-border-radius: 12px;" text="CEIT (Computer Engineering and Information Technology)" />
               </children>
            </HBox>

            <!-- METRIC CARDS ROW -->
            <HBox spacing="10.0">
               <children>
                  <!-- 1. All Classes -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 12px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" style="-fx-background-color: #dbeafe; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #2563eb; -fx-font-size: 17px;" text="👥" />
                                 </children>
                              </StackPane>
                              <Label fx:id="myClassesCountLabel" styleClass="metric-value" text="12" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="All Classes" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="University wide" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- 2. Total Students -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 12px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" style="-fx-background-color: #dcfce7; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #16a34a; -fx-font-size: 17px;" text="🎓" />
                                 </children>
                              </StackPane>
                              <Label styleClass="metric-value" text="348" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="Total Students" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Enrolled" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- 3. Total Teachers -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 12px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" style="-fx-background-color: #ffe4e6; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #e11d48; -fx-font-size: 17px;" text="👨‍🏫" />
                                 </children>
                              </StackPane>
                              <Label styleClass="metric-value" text="84" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="Total Teachers" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Active faculty" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- 4. Total Courses -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 12px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" style="-fx-background-color: #f3e8ff; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #9333ea; -fx-font-size: 17px;" text="📚" />
                                 </children>
                              </StackPane>
                              <Label styleClass="metric-value" text="96" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="Total Courses" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Course offerings" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>

                  <!-- 5. Today's Attendance -->
                  <VBox minWidth="0.0" spacing="6.0" style="-fx-padding: 12px;" styleClass="metric-card" HBox.hgrow="ALWAYS">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <StackPane maxHeight="36.0" maxWidth="36.0" minHeight="36.0" minWidth="36.0" style="-fx-background-color: #fef3c7; -fx-background-radius: 50em;">
                                 <children>
                                    <Label style="-fx-text-fill: #d97706; -fx-font-size: 17px;" text="📅" />
                                 </children>
                              </StackPane>
                              <Label styleClass="metric-value" text="92.3%" />
                           </children>
                        </HBox>
                        <VBox spacing="1.0">
                           <children>
                              <Label styleClass="metric-title" text="Today's Attendance" />
                              <Label style="-fx-font-size: 10px; -fx-text-fill: #94a3b8;" text="Campus average" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- CREATE COURSE & CREATE NEW CLASS ACTION CARD -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 16px 20px;" styleClass="panel-card">
               <children>
                  <StackPane maxHeight="42.0" maxWidth="42.0" minHeight="42.0" minWidth="42.0" style="-fx-background-color: #eff6ff; -fx-background-radius: 10px; -fx-border-color: #bfdbfe; -fx-border-radius: 10px;">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-text-fill: #2563eb;" text="📘" />
                     </children>
                  </StackPane>
                  <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label style="-fx-font-size: 14px;" styleClass="panel-header" text="Course Catalog &amp; Class Scheduling" />
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #64748b;" text="Register new courses with prerequisites, or schedule a new class offering and auto-enroll students by major, year, and semester." wrapText="true" />
                     </children>
                  </VBox>
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Button fx:id="createCourseBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleCreateCourse" styleClass="secondary-button" text="+ Create New Course" />
                        <Button fx:id="createClassBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleCreateClass" styleClass="action-button" text="+ Create New Class" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- TAB BAR: CLASS LIST (ADMIN VIEW) & DAILY ATTENDANCE LOG -->
            <HBox alignment="CENTER_LEFT" spacing="18.0" style="-fx-border-color: transparent transparent #cbd5e1 transparent; -fx-border-width: 0 0 2 0; -fx-padding: 6px 0 0 0;">
               <children>
                  <HBox fx:id="tabClassListBox" alignment="CENTER_LEFT" onMouseClicked="#switchToClassListTab" spacing="8.0" style="-fx-border-color: transparent transparent #1b315e transparent; -fx-border-width: 0 0 3.5 0; -fx-padding: 0 6px 6px 2px; -fx-cursor: hand;">
                     <children>
                        <Label fx:id="tabClassListLabel" style="-fx-text-fill: #0f172a; -fx-font-size: 14px; -fx-font-weight: 800;" text="📚  Class List (Admin View)" />
                        <Label fx:id="classListBadge" style="-fx-background-color: #fee2e2; -fx-text-fill: #dc2626; -fx-font-size: 11px; -fx-font-weight: bold; -fx-background-radius: 12px; -fx-padding: 2px 8px;" text="12 available" />
                     </children>
                  </HBox>
                  <HBox fx:id="tabDailyLogBox" alignment="CENTER_LEFT" onMouseClicked="#switchToDailyLogTab" spacing="6.0" style="-fx-border-color: transparent; -fx-border-width: 0 0 3.5 0; -fx-padding: 0 6px 6px 2px; -fx-cursor: hand;">
                     <children>
                        <Label fx:id="tabDailyLogLabel" style="-fx-text-fill: #64748b; -fx-font-size: 14px; -fx-font-weight: bold;" text="📅  Daily Attendance Log" />
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- TAB 1: CLASS LIST SECTION -->
            <VBox fx:id="classListSection" spacing="16.0">
               <children>
                  <!-- FILTER & SEARCH CLASSES -->
                  <VBox spacing="12.0" style="-fx-padding: 16px;" styleClass="panel-card">
                     <children>
                        <HBox alignment="CENTER_LEFT">
                           <children>
                              <Label style="-fx-font-size: 14px;" styleClass="panel-header" text="Filter &amp; Search Classes" />
                           </children>
                        </HBox>

                        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                           <children>
                              <VBox minWidth="140.0" prefWidth="175.0" spacing="4.0">
                                 <children>
                                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Academic Year" />
                                    <ComboBox fx:id="academicYearCombo" maxWidth="Infinity" promptText="All Years" styleClass="shaded-combo" />
                                 </children>
                              </VBox>

                              <VBox minWidth="140.0" prefWidth="175.0" spacing="4.0">
                                 <children>
                                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Semester" />
                                    <ComboBox fx:id="semesterCombo" maxWidth="Infinity" promptText="All Semesters" styleClass="shaded-combo" />
                                 </children>
                              </VBox>

                              <VBox minWidth="140.0" spacing="4.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" text="Search Classes" />
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                       <children>
                                          <TextField fx:id="searchField" minWidth="100.0" promptText="🔍 Search by class code, title, lecturer..." style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 7px 12px;" HBox.hgrow="ALWAYS" />
                                          <Button fx:id="resetFilterBtn" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleResetFilters" styleClass="secondary-button" text="↻ Reset" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- FIXED-HEIGHT COURSE CARDS GRID (716px = 2 rows × 350px + 16px vgap) -->
                  <GridPane fx:id="cardsGrid" hgap="16.0" maxHeight="716.0" minHeight="716.0" prefHeight="716.0" vgap="16.0">
                     <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                        <ColumnConstraints percentWidth="33.33" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints maxHeight="350.0" minHeight="350.0" prefHeight="350.0" />
                        <RowConstraints maxHeight="350.0" minHeight="350.0" prefHeight="350.0" />
                     </rowConstraints>
                  </GridPane>

                  <!-- BOTTOM FOOTER & DYNAMIC PAGINATION -->
                  <HBox alignment="CENTER_LEFT">
                     <children>
                        <Label fx:id="paginationInfoLabel" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Showing 1 - 6 of 12 classes" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="paginationControlsBox" alignment="CENTER" spacing="5.0" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- TAB 2: DAILY ATTENDANCE LOG SECTION (EDITABLE BY ADMIN) -->
            <VBox fx:id="dailyLogSection" managed="false" spacing="14.0" visible="false">
               <children>
                  <VBox spacing="10.0" styleClass="panel-card">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <DatePicker fx:id="dailyDatePicker" prefHeight="32.0" prefWidth="165.0" promptText="dd-MM-yyyy" styleClass="shaded-combo" />
                              <TextField fx:id="dailySearchField" prefHeight="32.0" promptText="Search student roll no, name, or subject..." style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px; -fx-padding: 6px 12px;" HBox.hgrow="ALWAYS" />
                           </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                           <children>
                              <Label style="-fx-text-fill: #1e3a8a; -fx-font-weight: bold; -fx-font-size: 12px;" text="Remarks / Status:" />
                              <CheckBox fx:id="chkPresent" mnemonicParsing="false" styleClass="shaded-checkbox" text="Present" />
                              <CheckBox fx:id="chkAbsent" mnemonicParsing="false" styleClass="shaded-checkbox" text="Absent" />
                              <CheckBox fx:id="chkExcuse" mnemonicParsing="false" styleClass="shaded-checkbox" text="Excuse" />
                              <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#applyDailyFilters" style="-fx-padding: 6px 16px;" styleClass="search-button" text="Filter" />
                              <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleResetDailyFilters" style="-fx-padding: 6px 16px;" styleClass="reset-button" text="Reset" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <HBox alignment="CENTER_LEFT" style="-fx-background-color: #eff6ff; -fx-padding: 10px 14px; -fx-background-radius: 6px; -fx-border-color: #bfdbfe; -fx-border-radius: 6px;">
                     <children>
                        <Label style="-fx-text-fill: #1d4ed8; -fx-font-weight: bold; -fx-font-size: 12.5px;" text="💡  Hint: Select a row and press &quot;Toggle Status&quot; to switch Present → Absent → Excused, then press &quot;Save Changes&quot;." />
                     </children>
                  </HBox>

                  <VBox spacing="14.0" styleClass="panel-card">
                     <children>
                        <TableView fx:id="dailyLogTable" prefHeight="360.0" style="-fx-background-color: white; -fx-background-radius: 6px; -fx-border-color: #cbd5e1; -fx-border-radius: 6px;">
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                           <columns>
                              <TableColumn fx:id="colNoLog" prefWidth="50.0" reorderable="false" sortable="false" text="No" />
                              <TableColumn fx:id="colRollLog" prefWidth="115.0" reorderable="false" sortable="false" text="Roll No" />
                              <TableColumn fx:id="colNameLog" prefWidth="165.0" reorderable="false" sortable="false" text="Student Name" />
                              <TableColumn fx:id="colDateLog" prefWidth="115.0" reorderable="false" sortable="false" text="Date" />
                              <TableColumn fx:id="colSubjLog" prefWidth="185.0" reorderable="false" sortable="false" text="Subject" />
                              <TableColumn fx:id="colStatusLog" prefWidth="125.0" reorderable="false" sortable="false" text="Status" />
                              <TableColumn fx:id="colRemarksLog" prefWidth="130.0" reorderable="false" sortable="false" text="Remarks" />
                           </columns>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="8.0">
                           <children>
                              <Label fx:id="dailyLogFooterLabel" style="-fx-text-fill: #64748b; -fx-font-size: 12px;" text="Showing 0 attendance records" />
                              <Region HBox.hgrow="ALWAYS" />
                              <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleToggleDailyStatus" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 7px 12px; -fx-font-size: 12px; -fx-cursor: hand;" text="🔄 Toggle Status" />
                              <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleResetDailyStatus" style="-fx-padding: 7px 12px; -fx-font-size: 12px;" styleClass="reset-button" text="↺ Reset Status" />
                              <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleMarkAllPresent" style="-fx-background-color: #16a34a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6px; -fx-padding: 7px 12px; -fx-font-size: 12px; -fx-cursor: hand;" text="✔ Mark All Present" />
                              <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#handleSaveDailyChanges" style="-fx-padding: 7px 12px; -fx-font-size: 12px;" styleClass="search-button" text="💾 Save Changes" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </content>
</ScrollPane>